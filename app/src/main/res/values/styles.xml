<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="GeneralAppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:alertDialogTheme">@style/GeneralDialogTheme</item>
        <item name="android:colorAccent">#E8B84A</item>
    </style>

    <style name="GeneralDialogTheme" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#E8B84A</item>
        <item name="android:textColorPrimary">#F2C45E</item>
        <item name="android:textColorSecondary">#F2C45E</item>
        <item name="android:textAppearanceMedium">@style/GeneralDialogTextAppearance</item>
        <item name="android:windowBackground">@drawable/bg_general_dialog</item>
        <item name="android:windowMinWidthMajor">78%</item>
        <item name="android:windowMinWidthMinor">88%</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.78</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/GeneralDialogButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/GeneralDialogButton</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/GeneralDialogButton</item>
    </style>

    <style name="GeneralDialogTextAppearance" parent="@android:style/TextAppearance.Material">
        <item name="android:textColor">#F2C45E</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="GeneralDialogButton" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:textColor">#F2C45E</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
